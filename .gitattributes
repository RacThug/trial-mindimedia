# LF in the working tree on every platform. Prettier writes LF and checks for it,
# so on a Windows clone with `core.autocrlf=true` every committed file failed
# `npm run format:check` while being byte-identical to what git stores - a check
# that could never pass locally and had nothing to report.
* text=auto eol=lf

# Git hooks and shell scripts must keep LF endings or sh cannot run them
.githooks/** text eol=lf
*.sh text eol=lf

# Committed assets are the byte-exact output of `npm run assets`. Without this,
# git rewrites the line endings in the two SVGs on a Windows checkout and the
# next pipeline run reports them as modified when nothing has changed.
public/media/** -text
